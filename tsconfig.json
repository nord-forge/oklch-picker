{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Typecheck the workspace from source. Without this, `@oklch-picker/*`
    // resolves to each package's built `.d.mts`, and the vanilla package's
    // global `<oklch-picker>` tag declaration then exists twice, once from
    // dist and once from src. TS reports that as a conflicting redeclaration.
    "paths": {
      "@oklch-picker/core": ["./packages/core/src/index.ts"],
      "@oklch-picker/react": ["./packages/react/src/index.ts"],
      "@oklch-picker/vue": ["./packages/vue/src/index.ts"],
      "oklch-picker": ["./packages/vanilla/src/index.ts"],
      "@oklch-picker/svelte": ["./packages/svelte/src/index.ts"],
      "@oklch-picker/solid": ["./packages/solid/src/index.tsx"],
      "@oklch-picker/angular": ["./packages/angular/src/index.ts"],
      "@oklch-picker/qwik": ["./packages/qwik/src/index.ts"]
    }
  },
  // Solid and Qwik are typechecked by their own tsconfigs. Each needs its own
  // `jsxImportSource`, and one pass cannot hold three JSX settings.
  //
  // Angular is typechecked by its own `ngc` build instead. `tsc` alone reports
  // its templates as untyped strings and misses the signal inputs entirely, so
  // the build is the check that means something.
  "include": ["packages/*/src/**/*.ts", "packages/*/src/**/*.tsx", "test/**/*.ts", "test/**/*.tsx"],
  "exclude": [
    "packages/solid",
    "packages/angular",
    "packages/qwik",
    "test/**/*solid*.test.tsx",
    "test/**/*qwik*.test.tsx",
    "test/**/*angular*.test.ts",
    "**/dist"
  ]
}
