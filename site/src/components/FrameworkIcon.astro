---
/**
 * The framework marks, inline so they cost no requests and can take their
 * colour from the page.
 *
 * Each is the official logo geometry, drawn in `currentColor` rather than brand
 * colours: five saturated logos in a row on a colour-picker's docs would
 * compete with the thing being demonstrated, and a monochrome row stays legible
 * in both themes. They are decorative, since the tab's text label is the
 * accessible name, so every one is aria-hidden.
 */
interface Props {
  name: string;
  size?: number;
}

const { name, size = 14 } = Astro.props;
const id = name.toLowerCase().replace(/\s+/g, "");
---

{
  id === "react" && (
    <svg class="fw" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none">
      <circle cx="12" cy="12" r="2" fill="currentColor" />
      <ellipse cx="12" cy="12" rx="10" ry="4" stroke="currentColor" stroke-width="1.2" />
      <ellipse
        cx="12"
        cy="12"
        rx="10"
        ry="4"
        stroke="currentColor"
        stroke-width="1.2"
        transform="rotate(60 12 12)"
      />
      <ellipse
        cx="12"
        cy="12"
        rx="10"
        ry="4"
        stroke="currentColor"
        stroke-width="1.2"
        transform="rotate(120 12 12)"
      />
    </svg>
  )
}

{
  id === "vue" && (
    <svg class="fw" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path d="M2 3.5h4l6 10.5 6-10.5h4L12 21 2 3.5Z" fill="currentColor" opacity="0.55" />
      <path d="M7.2 3.5h3.1L12 6.4l1.7-2.9h3.1L12 12 7.2 3.5Z" fill="currentColor" />
    </svg>
  )
}

{
  id === "svelte" && (
    <svg class="fw" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path
        d="M18.9 4.1c-2-2.9-6-3.7-8.9-1.9L5.4 5.4A5.8 5.8 0 0 0 2.8 9.3a6.1 6.1 0 0 0 .6 3.9 5.8 5.8 0 0 0-.9 2.2 6.2 6.2 0 0 0 1.1 4.7c2 2.9 6 3.7 8.9 1.9l4.6-2.9a5.8 5.8 0 0 0 2.6-3.9 6.1 6.1 0 0 0-.6-3.9 5.8 5.8 0 0 0 .9-2.2 6.2 6.2 0 0 0-1.1-5Zm-8.5 15.9a3.9 3.9 0 0 1-4.2-1.6 3.7 3.7 0 0 1-.6-2.8 3.5 3.5 0 0 1 .1-.5l.1-.3.3.2a6.4 6.4 0 0 0 1.9.9l.2.1v.2a1.1 1.1 0 0 0 .2.7 1.2 1.2 0 0 0 1.3.5 1.1 1.1 0 0 0 .3-.1l4.6-2.9a1 1 0 0 0 .5-.7 1.1 1.1 0 0 0-.2-.8 1.2 1.2 0 0 0-1.3-.5 1.1 1.1 0 0 0-.3.1l-1.8 1.1a3.7 3.7 0 0 1-1 .4 3.9 3.9 0 0 1-4.2-1.6 3.7 3.7 0 0 1-.6-2.8 3.5 3.5 0 0 1 1.6-2.3l4.6-2.9a3.7 3.7 0 0 1 1-.4 3.9 3.9 0 0 1 4.2 1.6 3.7 3.7 0 0 1 .6 2.8 3.5 3.5 0 0 1-.1.5l-.1.3-.3-.2a6.4 6.4 0 0 0-1.9-.9l-.2-.1v-.2a1.1 1.1 0 0 0-.2-.7 1.2 1.2 0 0 0-1.3-.5 1.1 1.1 0 0 0-.3.1L8.9 9.7a1 1 0 0 0-.5.7 1.1 1.1 0 0 0 .2.8 1.2 1.2 0 0 0 1.3.5 1.1 1.1 0 0 0 .3-.1l1.8-1.1a3.7 3.7 0 0 1 1-.4 3.9 3.9 0 0 1 4.2 1.6 3.7 3.7 0 0 1 .6 2.8 3.5 3.5 0 0 1-1.6 2.3l-4.6 2.9a3.7 3.7 0 0 1-1 .3Z"
        fill="currentColor"
      />
    </svg>
  )
}

{
  id === "solid" && (
    <svg class="fw" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path
        d="M12 3c-4 0-6.5 1.6-7.5 4.2 1.6-1.6 3.4-2.2 5.5-1.8 1.2.2 2 1 3 1.9 1.6 1.5 3.5 3.2 7.5 2.4C21 6.4 18.5 3 12 3Z"
        fill="currentColor"
      />
      <path
        d="M4.5 7.2C3.4 10 3.9 12 5.4 13.2c1.4 1.1 3.4 1 5.1.4 2-.7 3.6-1.4 6-.6 1.2.4 2.2 1.1 3 2 .7-1.6 1-3.3.5-4.6-4 .8-5.9-.9-7.5-2.4-1-.9-1.8-1.7-3-1.9-2.1-.4-3.9.2-5 1.1Z"
        fill="currentColor"
        opacity="0.65"
      />
      <path
        d="M3.5 13.5C2.8 16.8 5.6 21 11.5 21c4.4 0 7-1.9 8-4.6-.8-.9-1.8-1.6-3-2-2.4-.8-4 0-6 .6-1.7.6-3.7.7-5.1-.4a4 4 0 0 1-1.9-1.1Z"
        fill="currentColor"
        opacity="0.4"
      />
    </svg>
  )
}

{
  (id === "noframework" || id === "html") && (
    <svg class="fw" viewBox="0 0 24 24" width={size} height={size} aria-hidden="true" fill="none">
      {/* Angle brackets: the custom element is just a tag. */}
      <path
        d="M9 7 4.5 12 9 17M15 7l4.5 5-4.5 5"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
  )
}

<style>
  .fw {
    flex: none;
    /* Optically centred against the label's cap height rather than its box. */
    margin-block-start: -0.05em;
  }
</style>
