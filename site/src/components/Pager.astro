---
/**
 * Previous/next at the foot of a guide, derived from the same NAV the sidebar
 * renders — so reading order is defined once and the two cannot disagree.
 */
import { NAV } from "../lib/nav";
import { url } from "../lib/url";

const flat = NAV.flatMap((section) => section.items);
const here = Astro.url.pathname;

const index = flat.findIndex((item) => {
  const a = url(item.path);
  const b = here.endsWith("/") ? here : `${here}/`;
  return a === b;
});

const previous = index > 0 ? flat[index - 1] : undefined;
const next = index >= 0 && index < flat.length - 1 ? flat[index + 1] : undefined;
---

{
  (previous || next) && (
    <nav class="pager" aria-label="Documentation pages">
      {previous && (
        <a class="pager__link" href={url(previous.path)} rel="prev">
          <span class="pager__label">Previous</span>
          <span class="pager__title">{previous.title}</span>
        </a>
      )}
      {next && (
        <a class="pager__link pager__link--next" href={url(next.path)} rel="next">
          <span class="pager__label">Next</span>
          <span class="pager__title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}
