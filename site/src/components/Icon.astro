---
/**
 * Site chrome icons, kept apart from `FrameworkIcon`.
 *
 * That component answers "which framework is this tab", and its registry
 * decides whether a tab shows a mark at all. These are the page furniture
 * instead, named explicitly by whoever places them. Mixing them would mean a
 * stray tab labelled "GitHub" quietly picking up an icon.
 *
 * The name is a typed union rather than a free string, so a typo is a build
 * error here where a tab label cannot be. Add a case and widen the union to add
 * an icon; nothing else needs a registry, because every use site names the icon
 * it wants.
 *
 * Drawn in `currentColor` and aria-hidden, like the framework marks. Each one
 * here sits beside text that already names it, so the icon carries no
 * information a screen reader would miss.
 */
interface Props {
  name: "github" | "npm" | "changelog";
  size?: number;
}

const { name, size = 14 } = Astro.props;
---

{
  name === "github" && (
    <svg
      class="icon"
      viewBox="0 0 16 16"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
      fill="currentColor"
    >
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
    </svg>
  )
}

{
  name === "npm" && (
    <svg
      class="icon"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
      fill="currentColor"
    >
      {/* The registry's mark: a rounded square with a lowercase "n" reversed
          out of it. The counter comes from the subpath's winding direction, so
          this is one path rather than a square with a letter drawn on top. */}
      <path d="M1.763 0C.786 0 0 .786 0 1.763v20.474C0 23.214.786 24 1.763 24h20.474c.977 0 1.763-.786 1.763-1.763V1.763C24 .786 23.214 0 22.237 0zM5.13 5.323l13.837.019-.009 13.836h-3.464l.01-10.382h-3.456L12.04 19.17H5.113z" />
    </svg>
  )
}

{
  name === "changelog" && (
    <svg
      class="icon"
      viewBox="0 0 24 24"
      width={size}
      height={size}
      aria-hidden="true"
      focusable="false"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      {/* Two arrows circling: a release history is the same thing revised, not
          a document. */}
      <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" />
      <path d="M21 3v5h-5" />
      <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" />
      <path d="M3 21v-5h5" />
    </svg>
  )
}

<style>
  .icon {
    flex: none;
    display: block;
  }
</style>
