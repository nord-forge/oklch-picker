---
import Icon from "../components/Icon.astro";
import { NAV } from "../lib/nav";
import { url, isCurrent } from "../lib/url";
// The picker's own stylesheet, before the site's, so a `--okp-*` override in
// site.css wins. Imported here rather than in Picker.astro because the
// playground builds its element directly, and every page shows a picker.
import "@oklch-picker/core/styles.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  /** Set on the home page, which runs full-width without the sidebar. */
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;

// Canonical URLs need the deployed origin, which `site` in the config supplies.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const pathname = Astro.url.pathname;

// Absolute, because every crawler that reads these resolves them against its
// own origin rather than the page's. A root-relative path here shows a blank
// card on every platform that matters.
const ogImage = new URL(url("/og.png"), Astro.site).href;

// One entry, describing the library rather than the page. Google reads this to
// build the result card, and `SoftwareSourceCode` is what a package is.
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: "oklch-picker",
  description:
    "An OKLCH colour picker for React, Preact, Vue, Svelte, Solid, Angular, Qwik and no framework at all. Every axis is a slider over a gamut cross-section.",
  url: new URL(url("/"), Astro.site).href,
  codeRepository: "https://github.com/nord-forge/oklch-picker",
  programmingLanguage: "TypeScript",
  license: "https://opensource.org/licenses/MIT",
  keywords: [
    "oklch",
    "colour picker",
    "color picker",
    "gamut",
    "Display P3",
    "Rec. 2020",
    "React",
    "Vue",
    "Svelte",
    "Solid",
    "Angular",
    "Qwik",
    "Astro",
    "web component",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* The mark doubles as the favicon. An SVG scales to whatever the browser
        asks for, and every browser that supports `oklch()` supports it. */}
    <link rel="icon" href={url("/mark-light.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url("/og.png")} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="oklch-picker" />
    <meta property="og:locale" content="en_GB" />
    {/* PNG, not the SVG it is rendered from: no major platform previews SVG,
        so a card pointing at one is a blank card. 1200x630 is the size they
        all crop to. */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="oklch-picker: an OKLCH colour picker that takes the gamut seriously"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
      is:inline
    />

    {/* Pin the stored theme before first paint. Doing this in the body would
        show a flash of the system scheme first. */}
    <script is:inline>
      const stored = localStorage.getItem("okp-theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.dataset.theme = stored;
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#content">Skip to content</a>

    <header class="header">
      <a class="header__brand" href={url("/")}>
        {/* Both marks ship and CSS picks one. A `<source media="(prefers-color
            -scheme: dark)">` follows the system, so pinning the theme changed
            the page and left the mark on whatever the OS said. */}
        <img
          class="header__mark header__mark--light"
          src={url("/mark-light.svg")}
          alt=""
          width="28"
          height="28"
        />
        <img
          class="header__mark header__mark--dark"
          src={url("/mark-dark.svg")}
          alt=""
          width="28"
          height="28"
        />
        oklch-picker
      </a>

      <span class="header__spacer"></span>

      <a class="header__link" href={url("/playground")}>Playground</a>
      <a class="header__link" href="https://github.com/nord-forge/oklch-picker">GitHub</a>

      {/* Both icons ship and CSS shows one, rather than the script swapping
          SVG on every click and keeping the markup in two places. Icon and
          label both name the scheme in use. */}
      <button class="theme" type="button" data-theme-toggle aria-live="polite">
        <span class="theme__icon theme__icon--light"><Icon name="light" /></span>
        <span class="theme__icon theme__icon--dark"><Icon name="dark" /></span>
        <span class="theme__label" data-theme-label>Theme</span>
      </button>
    </header>

    {
      wide ? (
        <main id="content">
          <slot />
        </main>
      ) : (
        <div class="layout">
          <nav class="sidebar" aria-label="Documentation">
            {NAV.map((section) => (
              <div class="sidebar__section">
                <h2 class="sidebar__title">{section.title}</h2>
                <ul class="sidebar__list">
                  {section.items.map((item) => (
                    <li>
                      <a
                        class="sidebar__link"
                        href={url(item.path)}
                        aria-current={isCurrent(pathname, item.path) ? "page" : undefined}
                      >
                        {item.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </nav>

          <main class="content" id="content">
            <slot />
          </main>
        </div>
      )
    }

    <footer class="footer">
      <div class="footer__inner">
        <span>MIT licensed</span>
        <a class="footer__link" href="https://github.com/nord-forge/oklch-picker">
          <Icon name="github" />
          <span>Source</span>
        </a>
        <a class="footer__link" href="https://www.npmjs.com/package/oklch-picker">
          <Icon name="npm" />
          <span>npm</span>
        </a>
        <a
          class="footer__link"
          href="https://github.com/nord-forge/oklch-picker/blob/main/CHANGELOG.md"
        >
          <Icon name="changelog" />
          <span>Changelog</span>
        </a>
      </div>
    </footer>

    <script>
      // Copy buttons on standalone code blocks. CodeTabs brings its own, one
      // per set, so anything already inside a tab panel is skipped here.
      for (const pre of document.querySelectorAll<HTMLElement>(".content pre")) {
        if (pre.closest("[data-tabs]")) continue;

        const wrap = document.createElement("div");
        wrap.className = "codeblock";
        pre.parentNode?.insertBefore(wrap, pre);
        wrap.append(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "codeblock__copy";
        button.textContent = "Copy";
        button.setAttribute("aria-label", "Copy code");
        wrap.append(button);

        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText.trimEnd());
            button.textContent = "Copied";
          } catch {
            // Refused, or absent over plain HTTP. Say so rather than no-op.
            button.textContent = "Press Ctrl+C";
          }
          setTimeout(() => {
            button.textContent = "Copy";
          }, 1400);
        });
      }
    </script>

    <script>
      // Light and dark only. "System" is still the starting point, as the
      // absence of a stored key, so a first visit follows the OS. It stops
      // being reachable once a choice is made, because a three-way cycle made
      // the button hard to read: two of its states looked identical whenever
      // the system already matched the chosen one.
      const root = document.documentElement;
      const button = document.querySelector("[data-theme-toggle]");
      const label = document.querySelector("[data-theme-label]");

      /** What the page is showing now, resolving "system" through the OS. */
      function current(): "light" | "dark" {
        if (root.dataset.theme === "light") return "light";
        if (root.dataset.theme === "dark") return "dark";
        return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }

      function paint() {
        // The visible label names the scheme in use, because a word sitting in
        // the interface reads as "this is what I am" rather than as a promise
        // about the next click. The aria-label carries the action, which is
        // what a screen reader needs from a button.
        const now = current();
        const next = now === "dark" ? "light" : "dark";
        if (label) label.textContent = now === "dark" ? "Dark" : "Light";
        button?.setAttribute("aria-label", `Switch to ${next} mode`);
      }

      button?.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("okp-theme", next);
        paint();
      });

      // A visitor who has not chosen still follows the OS, so repaint if it
      // changes under them.
      window
        .matchMedia("(prefers-color-scheme: dark)")
        .addEventListener("change", () => !root.dataset.theme && paint());

      paint();
    </script>
  </body>
</html>
