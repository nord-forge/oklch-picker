{
  "name": "@oklch-picker/vue",
  "version": "1.1.1",
  "description": "An OKLCH colour picker for Vue, with gamut-aware sliders. Works with v-model.",
  "keywords": ["oklch", "colour", "color-picker", "vue", "gamut"],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.1"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/vue"
  }
}
