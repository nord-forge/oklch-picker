{
  "name": "@oklch-picker/vue",
  "version": "1.2.0",
  "description": "An OKLCH color picker for Vue 3. Gamut-aware sliders, wide-gamut P3 and Rec. 2020, works with v-model.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "vue",
    "vue3",
    "vue-component",
    "vue-color-picker",
    "vue-colour-picker"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@oklch-picker/core": "1.2.0"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/vue"
  }
}
