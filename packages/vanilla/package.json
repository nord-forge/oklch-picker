{
  "name": "oklch-picker",
  "version": "1.1.1",
  "//": "The bare name is the no-framework build: someone who types `npm i oklch-picker` without naming a framework wants the one that works anywhere. Framework users install @oklch-picker/react and friends.",
  "description": "An OKLCH color picker as a custom element. No framework, no build step. For plain HTML, HTMX, Alpine, Astro, and server-rendered pages.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "custom-element",
    "web-component",
    "vanilla",
    "html",
    "htmx",
    "alpine",
    "astro",
    "no-framework"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": ["**/*.css", "./dist/register.mjs"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/vanilla"
  }
}
