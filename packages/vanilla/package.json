{
  "name": "oklch-picker",
  "version": "1.1.0",
  "//": "The bare name is the no-framework build: someone who types `npm i oklch-picker` without naming a framework wants the one that works anywhere. Framework users install @oklch-picker/react and friends.",
  "description": "An OKLCH colour picker as a custom element. No framework, no build step. For plain HTML, HTMX, Alpine, Astro, and server-rendered pages.",
  "keywords": [
    "oklch",
    "colour",
    "color-picker",
    "custom-element",
    "web-component",
    "vanilla",
    "html",
    "htmx",
    "astro",
    "gamut"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/register.mjs"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/vanilla"
  }
}
