{
  "name": "@oklch-picker/qwik",
  "version": "1.1.1",
  "description": "An OKLCH color picker for Qwik, with gamut-aware sliders.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "qwik",
    "qwik-component",
    "qwik-color-picker",
    "qwik-colour-picker",
    "resumable"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "//": "Ships JSX source so Qwik's optimizer can split the $() boundaries in the consumer's build. Pre-bundling here would freeze them into one chunk and defeat resumability, which is the whole point of the framework.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": ["src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.1"
  },
  "peerDependencies": {
    "@builder.io/qwik": ">=1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/qwik"
  }
}
