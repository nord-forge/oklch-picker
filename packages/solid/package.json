{
  "name": "@oklch-picker/solid",
  "version": "1.0.1",
  "description": "An OKLCH colour picker for Solid, with gamut-aware sliders.",
  "keywords": ["oklch", "colour", "color-picker", "solid", "solid-js", "gamut"],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "//": "Ships JSX source so it compiles against the app's own Solid runtime. Pre-compiling here would bake in the wrong JSX pragma.",
  "files": ["src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@oklch-picker/core": "1.0.1"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/solid"
  }
}
