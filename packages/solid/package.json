{
  "name": "@oklch-picker/solid",
  "version": "1.1.1",
  "description": "An OKLCH color picker for Solid. Gamut-aware sliders, wide-gamut P3 and Rec. 2020, no dependencies.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "solid",
    "solid-js",
    "solidjs",
    "solid-color-picker",
    "solid-colour-picker"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "solid": "./src/index.tsx",
      "types": "./src/index.tsx",
      "default": "./src/index.tsx"
    },
    "./package.json": "./package.json"
  },
  "//": "Ships JSX source so it compiles against the app's own Solid runtime. Pre-compiling here would bake in the wrong JSX pragma.",
  "files": ["src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.1"
  },
  "peerDependencies": {
    "solid-js": ">=1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/solid"
  }
}
