{
  "name": "@oklch-picker/core",
  "version": "1.2.0",
  "description": "OKLCH color picker maths and headless model: the shared core behind every oklch-picker adapter. Zero dependencies.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "oklch-color",
    "oklch-colour",
    "headless",
    "color-math",
    "colour-math",
    "zero-dependency"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./colour": {
      "types": "./dist/colour.d.mts",
      "default": "./dist/colour.mjs"
    },
    "./gamuts": {
      "types": "./dist/gamuts.d.mts",
      "default": "./dist/gamuts.mjs"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.min.css": "./dist/styles.min.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/core"
  }
}
