{
  "name": "@oklch-picker/svelte",
  "version": "1.2.0",
  "description": "An OKLCH color picker for Svelte 5. Gamut-aware sliders, wide-gamut P3 and Rec. 2020, works with bind:value.",
  "keywords": [
    "oklch",
    "oklch-picker",
    "oklch-color-picker",
    "oklch-colour-picker",
    "color-picker",
    "colour-picker",
    "color",
    "colour",
    "picker",
    "gamut",
    "wide-gamut",
    "p3",
    "display-p3",
    "rec2020",
    "srgb",
    "color-space",
    "colour-space",
    "svelte",
    "svelte5",
    "svelte-component",
    "svelte-color-picker",
    "svelte-colour-picker"
  ],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "//": "Ships uncompiled .svelte source, the ecosystem convention. The consumer's tooling compiles it, so there is no dist and no build step.",
  "files": ["src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@oklch-picker/core": "1.2.0"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/svelte"
  }
}
