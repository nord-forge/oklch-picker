{
  "name": "@oklch-picker/svelte",
  "version": "1.1.1",
  "description": "An OKLCH colour picker for Svelte 5, with gamut-aware sliders. Works with bind:value.",
  "keywords": ["oklch", "colour", "color-picker", "svelte", "gamut"],
  "license": "MIT",
  "author": "Nick Bevers <hello@nickbevers.dev>",
  "homepage": "https://nord-forge.github.io/oklch-picker/",
  "bugs": {
    "url": "https://github.com/nord-forge/oklch-picker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "svelte": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "//": "Ships uncompiled .svelte source, the ecosystem convention. The consumer's tooling compiles it, so there is no dist and no build step.",
  "files": ["src", "README.md", "LICENSE"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@oklch-picker/core": "1.1.1"
  },
  "peerDependencies": {
    "svelte": ">=5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nord-forge/oklch-picker.git",
    "directory": "packages/svelte"
  }
}
